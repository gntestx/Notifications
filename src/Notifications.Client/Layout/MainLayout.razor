@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="false">
        <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Large" Class="mr-3" />
        <MudText Typo="Typo.h6">Notifications</MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Class="appbar-chip">PWA</MudChip>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="content-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = AzureMudTheme.Create();
}
