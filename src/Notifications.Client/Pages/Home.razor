@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject PushNotificationClient PushClient
@inject ISnackbar Snackbar

<PageTitle>Notifications</PageTitle>

<section class="hero">
    <div class="eyebrow">WEB PUSH · .NET 10</div>
    <MudText Typo="Typo.h2" Class="hero-title">Notiser som når fram.</MudText>
    <MudText Typo="Typo.subtitle1" Class="hero-copy">
        Installera appen, aktivera notiser och skicka ett meddelande till alla registrerade enheter.
    </MudText>
</section>

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <MudPaper Class="feature-card" Elevation="0">
            <div class="card-heading">
                <div class="card-icon receive-icon">↓</div>
                <div>
                    <MudText Typo="Typo.h5">Ta emot</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Den här enheten</MudText>
                </div>
            </div>

            @if (!_isSupported)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    Web Push stöds inte i den här webbläsaren. På iPhone måste appen först läggas till på hemskärmen.
                </MudAlert>
            }
            else
            {
                <div class="status-row">
                    <span class="status-dot @(_isSubscribed ? "active" : null)"></span>
                    <MudText Typo="Typo.body1">@SubscriptionStatus</MudText>
                </div>

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_busy"
                           OnClick="ToggleSubscriptionAsync">
                    @(_isSubscribed ? "Stäng av notiser" : "Aktivera notiser")
                </MudButton>
            }

            <MudText Typo="Typo.caption" Class="hint-text">
                Tillståndet gäller bara den här webbläsaren och kan återkallas när som helst.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="feature-card" Elevation="0">
            <div class="card-heading">
                <div class="card-icon send-icon">↑</div>
                <div>
                    <MudText Typo="Typo.h5">Skicka</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Till alla prenumeranter</MudText>
                </div>
            </div>

            <EditForm Model="_message" OnValidSubmit="SendAsync" FormName="send-notification">
                <DataAnnotationsValidator />
                <MudStack Spacing="2">
                    <MudTextField @bind-Value="_adminKey"
                                  Label="Sändningsnyckel"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Required="true" />
                    <MudTextField @bind-Value="_message.Title"
                                  Label="Rubrik"
                                  Variant="Variant.Outlined"
                                  MaxLength="80"
                                  Required="true" />
                    <MudTextField @bind-Value="_message.Body"
                                  Label="Meddelande"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  MaxLength="300"
                                  Required="true" />
                    <MudTextField @bind-Value="_message.Url"
                                  Label="Länk i appen"
                                  Variant="Variant.Outlined"
                                  HelperText="Måste börja med /"
                                  MaxLength="200" />
                    <MudButton ButtonType="ButtonType.Submit"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               FullWidth="true"
                               Size="Size.Large"
                               Disabled="_busy">
                        Skicka notis
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="privacy-strip" Elevation="0">
    <MudText Typo="Typo.body2">
        Prenumerationsuppgifter lagras i Azure Table Storage. Sändningsnyckeln skickas endast som en skyddad HTTP-header och sparas inte i webbläsaren.
    </MudText>
</MudPaper>

@code {
    private readonly NotificationRequest _message = new()
    {
        Title = "Ett nytt meddelande",
        Body = "Det här är en testnotis från Notifications.",
        Url = "/"
    };

    private bool _isSupported;
    private bool _isSubscribed;
    private bool _busy;
    private string _adminKey = string.Empty;

    private string SubscriptionStatus => _isSubscribed
        ? "Notiser är aktiverade"
        : "Notiser är inte aktiverade";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _isSupported = await PushClient.IsSupportedAsync();
        _isSubscribed = _isSupported && await PushClient.IsSubscribedAsync();
        StateHasChanged();
    }

    private async Task ToggleSubscriptionAsync()
    {
        _busy = true;
        try
        {
            if (_isSubscribed)
            {
                await PushClient.UnsubscribeAsync();
                _isSubscribed = false;
                Snackbar.Add("Notiser har stängts av på den här enheten.", Severity.Info);
            }
            else
            {
                await PushClient.SubscribeAsync();
                _isSubscribed = true;
                Snackbar.Add("Notiser är aktiverade.", Severity.Success);
            }
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_adminKey))
        {
            Snackbar.Add("Ange sändningsnyckeln.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var result = await PushClient.SendAsync(_message, _adminKey);
            Snackbar.Add($"Skickat: {result.Sent}. Misslyckades: {result.Failed}.", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}

